{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JaneMusic",
  "version": "3.0.0",
  "identifier": "com.liuxu.janemusic",
  "build": {
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Jane Music 4.0",
        "width": 860,
        "height": 600,
        "resizable": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      }
    }
  }
}
